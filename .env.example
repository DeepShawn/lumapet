# LumaPet server proxy (copy to .env or export in your process manager)
PORT=8787
HOST=127.0.0.1
LUMAPET_ALLOWED_ORIGIN=http://127.0.0.1:8787

LUMAPET_CLOUDGPT_API_KEY=
LUMAPET_CLOUDGPT_ENDPOINT=https://api.openai.com/v1/chat/completions
LUMAPET_CLOUDGPT_MODEL=gpt-4o-mini

LUMAPET_DEEPSEEK_API_KEY=
LUMAPET_DEEPSEEK_ENDPOINT=https://api.deepseek.com/chat/completions
LUMAPET_DEEPSEEK_MODEL=deepseek-chat

LUMAPET_CLAUDE_API_KEY=
LUMAPET_CLAUDE_BASE_URL=https://api.anthropic.com
LUMAPET_CLAUDE_MODEL=claude-opus-5-5

# Required when HOST is not localhost/127.0.0.1/::1.
LUMAPET_PROXY_TOKEN=
